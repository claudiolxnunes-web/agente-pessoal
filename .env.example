# Agente Pessoal v3.0 - Variáveis de Ambiente

# OpenAI (obrigatório)
OPENAI_API_KEY=sk-sua-chave-aqui
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.2

# Configurações do Agente
AGENT_NAME=MeuAgente
USER_NAME=Usuario

# Google Calendar + Gmail
GOOGLE_CALENDAR_ENABLED=false
GMAIL_ENABLED=false

# Notion
NOTION_TOKEN=secret_sua_chave_notion
NOTION_DATABASE_ID=sua_database_id
NOTION_ENABLED=false

# WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
WHATSAPP_ACCESS_TOKEN=seu_access_token
WHATSAPP_VERIFY_TOKEN=seu_verify_token
WHATSAPP_WEBHOOK_URL=https://seu-dominio.com/webhook

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=seu_token_telegram

# Web Search
SERPAPI_KEY=sua_chave_serpapi

# Agendamento
AUTO_SCHEDULE_ENABLED=true

# Voz/Áudio
VOICE_ENABLED=true
WHISPER_MODEL=base

# Banco de Dados
DATABASE_URL=sqlite:///memory/agente.db

# API REST
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ============================================
# 📧 E-MAILS - 4 Integrações Suportadas
# ============================================

# 1. Gmail (Google) - já configurado acima
# GMAIL_ENABLED=false

# 2. Outlook / Microsoft 365
# Como configurar:
# 1. https://portal.azure.com > App registrations > New registration
# 2. API permissions > add Microsoft Graph > Mail.Read, Mail.Send, Calendars.ReadWrite
# 3. Certificates & secrets > New client secret
# 4. Obtenha token via OAuth2 flow
OUTLOOK_ENABLED=false
OUTLOOK_CLIENT_ID=seu_client_id
OUTLOOK_CLIENT_SECRET=seu_client_secret
OUTLOOK_TENANT_ID=seu_tenant_id_ou_common
OUTLOOK_ACCESS_TOKEN=seu_access_token

# 3. Yahoo Mail
# Como configurar:
# 1. Acesse https://mail.yahoo.com > Account Info > Account Security
# 2. Ative "Allow apps that use less secure sign in" (ou use App Password)
# 3. Gere App Password se tiver 2FA ativado
YAHOO_MAIL_ENABLED=false
YAHOO_EMAIL=seu_email@yahoo.com
YAHOO_APP_PASSWORD=sua_app_password

# 4. ProtonMail
# Como configurar:
# 1. Acesse https://mail.proton.me > Configurações > API
# 2. Crie token de acesso com permissões de leitura e envio
PROTONMAIL_ENABLED=false
PROTONMAIL_API_TOKEN=seu_api_token
PROTONMAIL_USERNAME=seu_usuario@proton.me
